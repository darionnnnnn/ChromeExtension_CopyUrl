{
  "manifest_version": 3,
  "name": "Link Quick Copier",
  "version": "1.4",
  "description": "Hover copy: Cmd/Ctrl+C (Overwrite), Opt/Alt+C (Append)",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
