{
  "manifest_version": 3,
  "name": "Link Quick Copier",
  "version": "1.5",
  "description": "Hover copy: Cmd/Ctrl+C (Overwrite), Opt/Alt+C (Append)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
